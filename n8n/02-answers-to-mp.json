{
  "name": "Панель → МП: отправка ответов",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Каждые 5 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -340,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mp-send-answer",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Вебхук от панели",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -340,
        380
      ],
      "webhookId": "b2000000-0000-4000-8000-0000000000ff",
      "notes": "Production URL этого узла вставляется в настройках панели в поле «Вебхук n8n для немедленной отправки»."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ПАНЕЛЬ.example.com/api/outbox",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body && $json.body.reviewId ? { limit: 25, reviewId: $json.body.reviewId } : { limit: 25 }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Панель: взять очередь",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        290
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_PANEL_CREDENTIAL_ID",
          "name": "Панель x-api-key"
        }
      },
      "notes": "Панель сама помечает выданные отзывы как sending, поэтому два параллельных прогона не отправят ответ дважды."
    },
    {
      "parameters": {
        "jsCode": "// Разворачиваем партию в отдельные элементы: по одному ответу на отзыв.\nconst items = $input.first()?.json?.items ?? [];\nreturn items.map((item) => ({ json: item }));"
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Развернуть очередь",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        290
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "По одному ответу",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        340,
        290
      ],
      "notes": "Строго по одному: так каждый ответ маркетплейса однозначно сопоставляется со своим отзывом."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-wb",
              "leftValue": "={{ $json.marketplace }}",
              "rightValue": "wb",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Wildberries или Ozon?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        580,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://feedbacks-api.wildberries.ru/api/v1/feedbacks/answer",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.externalId, text: $json.answerText }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "WB: ответить на отзыв",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        280
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WB_CREDENTIAL_ID",
          "name": "WB Feedbacks token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-seller.ozon.ru/v1/review/comment/create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ review_id: $json.externalId, text: $json.answerText, mark_review_as_processed: $json.ozonMarkProcessed }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Ozon: оставить комментарий",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        480
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "credentials": {
        "httpCustomAuth": {
          "id": "REPLACE_OZON_CREDENTIAL_ID",
          "name": "Ozon Seller API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Превращаем ответ маркетплейса в строку результата для колбэка панели.\nconst current = $('По одному ответу').first().json;\nconst response = $input.first()?.json ?? {};\n\n// WB отдаёт error: false при успехе, Ozon - comment_id; ошибки приходят\n// либо телом с code/message, либо объектом error от самого узла HTTP Request.\nconst wbFailed = response.error === true || (response.error && typeof response.error === 'object');\nconst ozonFailed = Boolean(response.code) || Boolean(response.message);\nconst failed = wbFailed || ozonFailed;\n\nconst errorText = failed\n  ? String(\n      response.errorText ||\n        response.message ||\n        (response.error && (response.error.message || JSON.stringify(response.error))) ||\n        'Маркетплейс вернул ошибку',\n    ).slice(0, 500)\n  : null;\n\nreturn [\n  {\n    json: {\n      id: current.id,\n      ok: !failed,\n      error: errorText,\n      externalCommentId: response.comment_id ?? null,\n    },\n  },\n];"
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Записать результат",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ПАНЕЛЬ.example.com/api/outbox/callback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000010",
      "name": "Панель: колбэк",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_PANEL_CREDENTIAL_ID",
          "name": "Панель x-api-key"
        }
      },
      "notes": "Панель переводит отзывы в sent или failed. Без колбэка они зависнут в статусе «Отправляется»."
    },
    {
      "parameters": {
        "jsCode": "// Собираем исходы всех отправок в одну партию для колбэка панели.\nconst results = $input.all().map((item) => item.json).filter((row) => row && row.id);\nif (results.length === 0) return [];\nreturn [{ json: { results } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000011",
      "name": "Собрать результаты",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        120
      ]
    }
  ],
