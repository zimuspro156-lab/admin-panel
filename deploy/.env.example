# Домен панели. Caddy сам выпустит сертификат Let's Encrypt.
# Пока домена нет, оставьте :80 - будет работать по HTTP на IP сервера.
PANEL_DOMAIN=:80

# Пароль локального Postgres: openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -base64 32  (ровно 32 байта)
ENCRYPTION_KEY=

# openssl rand -hex 32  - этот же ключ пойдёт в credentials n8n
N8N_API_KEY=
