# Домен панели. Используется, только если поднимаете свой Caddy
# (docker compose --profile edge up -d). Он сам выпустит сертификат Let's Encrypt.
# Пока домена нет, оставьте :80 - будет работать по HTTP на IP сервера.
PANEL_DOMAIN=:80

# Куда публиковать порт панели. По умолчанию только на петлю: наружу её
# выпускает Caddy или уже стоящий на сервере обратный прокси.
# Если панель должна слушать все интерфейсы напрямую: PANEL_BIND=0.0.0.0:3000
PANEL_BIND=127.0.0.1:3000

# Пароль локального Postgres: openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -base64 32  (ровно 32 байта)
ENCRYPTION_KEY=

# openssl rand -hex 32  - этот же ключ пойдёт в credentials n8n
N8N_API_KEY=
