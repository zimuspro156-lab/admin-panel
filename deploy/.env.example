# Домен панели. Используется, только если поднимаете свой Caddy
# (docker compose --profile edge up -d). Он сам выпустит сертификат Let's Encrypt.
# Пока домена нет, оставьте :80 - будет работать по HTTP на IP сервера.
PANEL_DOMAIN=:80

# Имя сети Docker, в которой работает уже стоящий на сервере обратный прокси
# (посмотреть: docker network ls). Задавайте, только если прокси живёт в Docker
# и должен достучаться до панели: тогда она встанет в ту же сеть, а адресом для
# прокси станет mp-reviews-panel-1:3000
# EDGE_NETWORK=n8n_default

# Куда публиковать порт панели. По умолчанию только на петлю: наружу её
# выпускает Caddy или уже стоящий на сервере обратный прокси.
# Если панель должна быть доступна по http://IP:порт без домена и прокси:
#   PANEL_BIND=0.0.0.0:3000
# Учтите: так она открыта всему интернету и работает без шифрования - пароль
# при входе идёт открытым текстом. Для постоянной работы заведите домен.
PANEL_BIND=127.0.0.1:3000

# Пароль локального Postgres: openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -base64 32  (ровно 32 байта)
ENCRYPTION_KEY=

# openssl rand -hex 32  - этот же ключ пойдёт в credentials n8n
N8N_API_KEY=
