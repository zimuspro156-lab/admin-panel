# --- База данных -----------------------------------------------------------
# Managed Postgres (Neon, Supabase, Yandex Cloud). Для serverless берите
# pooler-строку: у Supabase это порт 6543, у Neon хост с суффиксом -pooler.
DATABASE_URL=postgresql://user:password@host:5432/reviews
# Локальный Postgres без TLS: добавьте ?sslmode=disable
# DATABASE_URL=postgresql://postgres:pg@127.0.0.1:5432/reviews?sslmode=disable
DATABASE_POOL_MAX=5

# --- Сессии ----------------------------------------------------------------
# Минимум 32 символа. Сгенерировать: openssl rand -base64 48
SESSION_SECRET=

# --- Интеграция с n8n ------------------------------------------------------
# Общий ключ для машинных ручек /api/ingest/reviews, /api/outbox,
# /api/outbox/callback. Тот же ключ прописывается в credentials n8n.
# Сгенерировать: openssl rand -hex 32
N8N_API_KEY=
