# --- База данных -----------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/reviews
# Локальный Postgres без TLS: добавьте ?sslmode=disable
DATABASE_POOL_MAX=5

# --- Сессии ----------------------------------------------------------------
# Минимум 32 символа. Сгенерировать: openssl rand -base64 48
SESSION_SECRET=

# --- Шифрование доступов ---------------------------------------------------
# Ровно 32 байта в base64: openssl rand -base64 32
# Этим ключом шифруются токены WB, Ozon и OpenAI, которые вводятся в панели.
# Потеряете ключ - доступы придётся ввести заново.
ENCRYPTION_KEY=

# --- Запуск заданий из n8n -------------------------------------------------
# Общий ключ для /api/jobs/sync и /api/jobs/flush.
# Сгенерировать: openssl rand -hex 32
N8N_API_KEY=
